# ─── App ───────────────────────────────────────────────────────────
# URL pública (sem barra no fim). Em produção, sempre HTTPS.
APP_URL=http://localhost:3000
# Segredo do Vercel Cron no header Authorization (Bearer); sem ele, /api/cron/limpeza responde 401.
# Gere com: openssl rand -hex 32
CRON_SECRET=

# ─── Banco (Neon) ─────────────────────────────────────────────────
# Em produção/preview: URL "pooled" do Neon (host com -pooler).
# Local: postgresql://postgres:postgres@localhost:5432/trilha_dev
DATABASE_URL=
# Conexão direta (host sem -pooler) usada só pelas migrations; se vazia, usa DATABASE_URL.
DIRECT_URL=
# Usado só pelos testes e2e (banco descartável com as migrations aplicadas).
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trilha_e2e

# ─── Pipeline do catálogo (GitHub Actions) ─────────────────────────
# E-mail de contato no User-Agent da coleta dos exam guides (secret do repositório no GitHub).
PIPELINE_CONTACT_EMAIL=

# ─── IA (etapa 6) ─────────────────────────────────────────────────
# Gemini na camada grátis é o padrão (docs/adr/0001-ia-gemini-padrao.md); Claude é a alternativa paga.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_MODEL_DEFAULT=
AI_MODEL_FALLBACK=
# Teto mensal em dólares; ao atingir, a geração pausa e o admin é avisado.
AI_MONTHLY_BUDGET_USD=20
ADMIN_ALERT_EMAIL=

# ─── Stripe (etapa 7) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_ANUAL=
STRIPE_PRICE_ANUAL_PIX=
STRIPE_TRIAL_DAYS=7

# ─── E-mail (Resend) ──────────────────────────────────────────────
# Sem chave, os e-mails ficam só no log (dev/test).
RESEND_API_KEY=
EMAIL_FROM="Trilha <nao-responda@seudominio.com.br>"

# ─── Sentry ───────────────────────────────────────────────────────
# Sem DSN, o Sentry fica desligado (src/instrumentation*.ts).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
