// Schema do produto. Datas sempre em UTC; "dia" e "semana" são calculados em America/Sao_Paulo.
// Os modelos entram por etapa (docs/estado.md): conta na etapa 2, catálogo na etapa 3, e assim por diante.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Conta (etapa 2) ─────────────────────────────

enum Role {
  USER
  ADMIN
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique // normalizado: minúsculas + trim
  passwordHash    String
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Preferências de estudo (motor-de-estudo)
  dailyGoalMin      Int @default(120)
  streakMinMin      Int @default(30)
  pomodoroWorkMin   Int @default(25)
  pomodoroBreakMin  Int @default(5)
  pomodoroLongMin   Int @default(15)
  pomodoroLongEvery Int @default(4)

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  consents                Consent[]
  notificationPreference  NotificationPreference?
  auditLogs               AuditLog[]
  userExams               UserExam[]
  studySessions           StudySession[]
  userTopics              UserTopic[]
  studyCycles             StudyCycle[]
  reviews                 Review[]
  mockAttempts            MockAttempt[]
  answers                 Answer[]
  readinessScores         ReadinessScore[]
  contentReports          ContentReport[]
  subscription            Subscription?
  certifications          UserCertification[]
}

/// Sessão de login. O cookie guarda o token; o banco guarda só o hash SHA-256.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ConsentKind {
  TERMOS
  PRIVACIDADE
}

/// Aceite de termos e privacidade (LGPD): versão e data.
model Consent {
  id         String      @id @default(cuid())
  userId     String
  kind       ConsentKind
  version    String
  acceptedAt DateTime    @default(now())
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// E-mails opcionais. Os de segurança (confirmação, reset, senha alterada) são sempre enviados.
model NotificationPreference {
  userId          String  @id
  revisoes        Boolean @default(true)
  mudancaExame    Boolean @default(true)
  recertificacao  Boolean @default(true)
  avisosPagamento Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Rate limit por janela fixa no Postgres (sem Redis).
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ───────────────────────────── Catálogo (etapa 3) ─────────────────────────────
// Dado, não código: cada exame é uma versão (SAA-C03) com domínios e pesos por revisão do exam guide.
// Campo sem fonte oficial citada fica nulo e com dataStatus A_CONFIRMAR.

enum CertLevel {
  FOUNDATIONAL
  ASSOCIATE
  PROFESSIONAL
  SPECIALTY
}

enum ExamStatus {
  BETA
  ACTIVE
  RETIRING
  RETIRED
}

enum PublishState {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum DataStatus {
  OFFICIAL
  A_CONFIRMAR
}

/// Identidade estável que atravessa versões ("Solutions Architect – Associate").
model Certification {
  id         String              @id @default(cuid())
  slug       String              @unique
  name       String // nome oficial, em inglês
  level      CertLevel
  trackOrder Int // ordem sugerida dentro do nível
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  versions   ExamVersion[]
  holders    UserCertification[]
}

/// O que a AWS publica de fato: código, status, formato, corte, preço e datas.
model ExamVersion {
  id              String           @id @default(cuid())
  certificationId String
  code            String           @unique // "SAA-C03"
  status          ExamStatus
  questionCount   Int? // total, com as não pontuadas; null = a confirmar
  scoredQuestions Int?
  durationMinutes Int?
  passingScore    Int? // escala 100–1000
  priceUsd        Decimal?         @db.Decimal(8, 2)
  validityMonths  Int              @default(36)
  launchedAt      DateTime?
  retiresAt       DateTime?
  sourceUrl       String // exam guide oficial
  infoUrl         String? // página oficial da certificação (duração, preço)
  retrievedAt     DateTime // quando a fonte foi lida
  dataStatus      DataStatus       @default(A_CONFIRMAR)
  publishState    PublishState     @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  certification   Certification    @relation(fields: [certificationId], references: [id])
  domains         Domain[]
  followers       UserExam[]
  studySessions   StudySession[]
  studyCycles     StudyCycle[]
  questions       Question[]
  mockAttempts    MockAttempt[]
  readinessScores ReadinessScore[]

  @@index([certificationId, status])
}

/// Domínio (pai) ou task statement (folha). A folha é o "tópico" do estudo.
model Domain {
  id              String             @id @default(cuid())
  examVersionId   String
  parentId        String?
  code            String // "1", "1.2"
  nameEn          String
  namePt          String?
  order           Int
  retiredAt       DateTime? // saiu do exam guide; fica para não perder o histórico (e o progresso, a partir da etapa 4)
  examVersion     ExamVersion        @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  parent          Domain?            @relation("DomainTree", fields: [parentId], references: [id])
  children        Domain[]           @relation("DomainTree")
  weights         BlueprintWeight[]
  sessions        StudySession[]     @relation("SessionDomain")
  topicSessions   StudySession[]     @relation("SessionTopic")
  userTopics      UserTopic[]
  cycleItems      StudyCycleDomain[]
  reviews         Review[]
  questions       Question[]         @relation("QuestionDomain")
  topicQuestions  Question[]         @relation("QuestionTopic")
  readinessScores ReadinessScore[]
  summary         Summary?
  flashcards      Flashcard[]
  contentReports  ContentReport[]

  @@unique([examVersionId, code])
  @@index([parentId])
}

/// Peso do domínio por revisão do exam guide; o diff sai da comparação entre revisões.
model BlueprintWeight {
  id            String     @id @default(cuid())
  domainId      String
  revision      Int
  weightPct     Decimal?   @db.Decimal(5, 2) // null = a confirmar
  sourceUrl     String
  sourceHash    String // SHA-256 do blueprint normalizado coletado
  effectiveFrom DateTime
  dataStatus    DataStatus
  createdAt     DateTime   @default(now())
  domain        Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, revision])
}

// ───────────────────────── Pipeline do catálogo (etapa 3b) ─────────────────────────
// Execução mensal no GitHub Actions (scripts/pipeline/catalogo.ts). O que não pode publicar sozinho vai para a fila.

enum CatalogRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

/// Uma execução da pipeline: contadores e erros.
model CatalogRun {
  id              String           @id @default(cuid())
  status          CatalogRunStatus @default(RUNNING)
  startedAt       DateTime         @default(now())
  finishedAt      DateTime?
  examsChecked    Int              @default(0)
  examsUnchanged  Int              @default(0)
  examsPublished  Int              @default(0)
  examsModeration Int              @default(0)
  errors          Json             @default("[]")
  reviews         CatalogReview[]

  @@index([startedAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

/// Coleta que mudou o exame mas não passou na confiança: espera o admin aprovar ou rejeitar.
model CatalogReview {
  id          String       @id @default(cuid())
  runId       String?
  examCode    String
  payload     Json // ExameColetado completo, aplicado por aplicarExame ao aprovar
  payloadHash String
  diff        Json
  confidence  Decimal      @db.Decimal(3, 2)
  problems    Json         @default("[]")
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?
  run         CatalogRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([examCode, payloadHash])
  @@index([status, createdAt])
}

// ───────────────────────────── Estudo (etapa 4) ─────────────────────────────
// Regras em src/lib/estudo (motor-de-estudo). O "tópico" é a folha do blueprint (task statement).
// Do lado do catálogo as relações são Restrict: versão e domínio nunca são apagados com estudo gravado.

enum StudyMode {
  LIVRE
  POMODORO
  FOCO
  CICLO
}

enum TopicStatus {
  NAO_INICIADO
  ESTUDANDO
  CONCLUIDO
  REVISAR
}

/// Exame que o usuário estuda, com a data de prova se ele marcou.
enum FollowStatus {
  ATIVO
  PAUSADO // downgrade: fica pausado, nunca apagado
}

model UserExam {
  id            String       @id @default(cuid())
  userId        String
  examVersionId String
  status        FollowStatus @default(ATIVO)
  examDate      DateTime? // dia da prova, 00:00 UTC
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examVersion   ExamVersion  @relation(fields: [examVersionId], references: [id])

  @@unique([userId, examVersionId])
  @@index([examVersionId])
}

/// Sessão de estudo. Cronometrada (startedAt/pausas/endedAt do servidor) ou manual.
/// Uma ativa por usuário (índice parcial na migration) e endedAt >= startedAt (CHECK).
model StudySession {
  id            String       @id @default(cuid())
  userId        String
  examVersionId String
  domainId      String // domínio (pai), obrigatório
  topicId       String? // task statement, opcional
  mode          StudyMode    @default(LIVRE)
  manual        Boolean      @default(false)
  startedAt     DateTime
  endedAt       DateTime?
  durationSec   Int? // tempo efetivo, sem pausas
  autoClosed    Boolean      @default(false) // encerrada em 4h pelo sistema; aguarda o tempo real
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examVersion   ExamVersion  @relation(fields: [examVersionId], references: [id])
  domain        Domain       @relation("SessionDomain", fields: [domainId], references: [id])
  topic         Domain?      @relation("SessionTopic", fields: [topicId], references: [id])
  pauses        StudyPause[]

  @@index([userId, startedAt])
  @@index([examVersionId])
  @@index([domainId])
  @@index([topicId])
}

model StudyPause {
  id        String       @id @default(cuid())
  sessionId String
  startedAt DateTime
  endedAt   DateTime?
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Status do usuário em cada task statement.
model UserTopic {
  id          String      @id @default(cuid())
  userId      String
  topicId     String
  status      TopicStatus @default(NAO_INICIADO)
  completedAt DateTime?
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Domain      @relation(fields: [topicId], references: [id])

  @@unique([userId, topicId])
  @@index([topicId])
}

// ───────────────────────── Ciclo e revisão espaçada (etapa 4b) ─────────────────────────

/// Ciclo de estudos de um exame: carga por domínio. Um aberto por usuário (índice parcial na migration).
model StudyCycle {
  id            String             @id @default(cuid())
  userId        String
  examVersionId String
  totalMin      Int
  number        Int                @default(1)
  startedAt     DateTime           @default(now())
  closedAt      DateTime?
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  examVersion   ExamVersion        @relation(fields: [examVersionId], references: [id])
  items         StudyCycleDomain[]

  @@index([userId, closedAt])
  @@index([examVersionId])
}

model StudyCycleDomain {
  id        String     @id @default(cuid())
  cycleId   String
  domainId  String
  targetMin Int
  doneMin   Int        @default(0) // recalculado a partir das sessões registradas depois do início do ciclo
  cycle     StudyCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  domain    Domain     @relation(fields: [domainId], references: [id])

  @@unique([cycleId, domainId])
  @@index([domainId])
}

/// Revisão espaçada de uma task statement (+1, +7, +30 dias). Uma pendente por tarefa (índice parcial).
model Review {
  id         String    @id @default(cuid())
  userId     String
  topicId    String
  step       Int       @default(0)
  dueAt      DateTime
  doneAt     DateTime?
  goodResult Boolean?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic      Domain    @relation(fields: [topicId], references: [id])

  @@index([userId, doneAt, dueAt])
  @@index([topicId])
}

// ───────────────────────── Simulados (etapa 5) ─────────────────────────

enum QuestionType {
  SINGLE
  MULTIPLE
}

enum AttemptMode {
  TREINO
  PROVA
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED // prazo do modo prova acabou; corrigido pelo servidor com o que foi respondido
}

/// Banco próprio (nunca questão real de prova). Entra por importação JSON validada e só aparece depois de moderada.
model Question {
  id            String       @id @default(cuid())
  examVersionId String
  domainId      String // domínio (pai)
  topicId       String? // task statement, quando a questão é de uma só
  type          QuestionType
  stem          String
  options       Json // [{ key: "A", text }] validado por Zod
  correctKeys   String[] // nunca vai ao cliente antes da resposta
  explanation   String
  docUrls       String[] // só https de host oficial
  origin        String // "autoral" | "ia"
  promptVersion String?
  contentHash   String       @unique // deduplicação (enunciado + alternativas normalizados)
  publishState  PublishState @default(PENDING_REVIEW)
  reviewNote    String?
  importedAt    DateTime     @default(now())
  reviewedAt    DateTime?
  examVersion   ExamVersion  @relation(fields: [examVersionId], references: [id])
  domain        Domain       @relation("QuestionDomain", fields: [domainId], references: [id])
  topic         Domain?      @relation("QuestionTopic", fields: [topicId], references: [id])
  answers       Answer[]

  @@index([examVersionId, domainId, publishState])
  @@index([topicId])
}

/// Simulado (treino ou prova): sorteio congelado no início e prazo definido no servidor.
model MockAttempt {
  id            String        @id @default(cuid())
  userId        String
  examVersionId String
  mode          AttemptMode
  status        AttemptStatus @default(IN_PROGRESS)
  domainFilter  String[] // vazio = exame inteiro
  questionIds   String[] // ordem de apresentação
  startedAt     DateTime      @default(now())
  deadlineAt    DateTime? // só no modo prova
  submittedAt   DateTime?
  correctCount  Int?
  domainReport  Json? // snapshot por domínio no envio
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  examVersion   ExamVersion   @relation(fields: [examVersionId], references: [id])
  answers       Answer[]

  @@index([userId, startedAt])
  @@index([examVersionId])
}

/// Resposta: acerto e tempo calculados no servidor; alimenta o relatório, a prontidão e o ciclo.
model Answer {
  id           String      @id @default(cuid())
  attemptId    String
  userId       String // desnormalizado para a prontidão (o dono vem do simulado)
  questionId   String
  domainId     String // desnormalizado da questão
  topicId      String?
  selectedKeys String[]
  isCorrect    Boolean
  timeMs       Int
  answeredAt   DateTime    @default(now())
  attempt      MockAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([userId, domainId, answeredAt])
  @@index([questionId])
}

/// Foto da prontidão (src/lib/prontidao), gravada ao encerrar um simulado. domainId nulo = exame.
/// Escores 0–100; cobertura 0–1. É estimativa, nunca nota prevista do exame.
model ReadinessScore {
  id                 String      @id @default(cuid())
  userId             String
  examVersionId      String
  domainId           String?
  score              Float
  lowerBound         Float
  upperBound         Float
  coverage           Float
  sampleSize         Int
  methodologyVersion String
  computedAt         DateTime    @default(now())
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  examVersion        ExamVersion @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  domain             Domain?     @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([userId, examVersionId, computedAt])
}

// ───────────────────────── Conteúdo com IA ─────────────────────────

/// Custo de cada chamada à IA (teto mensal em AI_MONTHLY_BUDGET_USD). Sem dado de usuário.
model AiUsageLog {
  id            String   @id @default(cuid())
  purpose       String // "material"
  model         String
  inputTokens   Int
  outputTokens  Int
  cachedTokens  Int      @default(0)
  costUsd       Decimal  @db.Decimal(10, 6)
  promptVersion String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

/// Resumo de uma tarefa (task statement), gerado uma vez e compartilhado entre todos.
model Summary {
  id            String   @id @default(cuid())
  topicId       String   @unique
  body          String // markdown restrito (parágrafos, listas, negrito, código)
  sources       String[] // só https de host oficial
  model         String
  promptVersion String
  published     Boolean  @default(true)
  createdAt     DateTime @default(now()) // regravado a cada geração (conta reports só da versão atual)
  topic         Domain   @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id            String   @id @default(cuid())
  topicId       String
  front         String
  back          String
  promptVersion String
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  topic         Domain   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, published])
}

/// "Reportar erro" no conteúdo gerado por IA; fila do admin.
model ContentReport {
  id          String    @id @default(cuid())
  userId      String?
  topicId     String
  contentType String // "summary" | "flashcard"
  contentId   String
  message     String
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  topic       Domain    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
  @@index([topicId, createdAt])
  @@index([userId])
}

// ───────────────────────────── Assinaturas ─────────────────────────────

/// Estado da assinatura, sempre gravado a partir do objeto atual do Stripe.
model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  stripeCustomerId      String    @unique
  stripeSubscriptionId  String?   @unique
  status                String? // status do Stripe: trialing, active, past_due...
  priceId               String?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  graceUntil            DateTime?
  accessUntil           DateTime? // Pix anual avulso
  renewalReminderSentAt DateTime? // lembrete de renovação do Pix já enviado para o accessUntil atual
  effectivePlan         String    @default("FREE") // último plano efetivo aplicado (FREE|PRO), para detectar transições
  updatedAt             DateTime  @updatedAt
  createdAt             DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Idempotência do webhook: um registro por event.id processado.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ───────────────────────────── Carteira (etapa 8) ─────────────────────────────

enum ExamResult {
  PASSED
  FAILED
}

/// Certificação que o usuário declara ter feito. Autodeclarada: sem credencial nem conta AWS.
model UserCertification {
  id              String        @id @default(cuid())
  userId          String
  certificationId String
  examCode        String? // versão feita, se souber
  result          ExamResult
  examDate        DateTime // dia, 00:00 UTC
  scaledScore     Int? // 100–1000
  expiresAt       DateTime? // só PASSED: examDate + validade da certificação
  badgeUrl        String? // https, opcional
  reminderStage   Int? // último lembrete enviado, em dias antes do vencimento (180, 90, 30, 7)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification   Certification @relation(fields: [certificationId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}
